{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "security": {
      "capabilities": [
        "default",
        "desktop-capability",
        {
          "identifier": "updater-capability",
          "description": "Updater access for the signed direct-download build only",
          "windows": ["main"],
          "permissions": ["updater:default"]
        }
      ]
    }
  }
}
