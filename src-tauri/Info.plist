<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Pressay implements standard cryptography for local history and E2EE sync.
       Keep this aligned with the export-compliance declaration in App Store Connect.
       The protected MAS release workflow injects Apple's approved
       ITSEncryptionExportComplianceCode into the built bundle before signing. -->
  <key>ITSAppUsesNonExemptEncryption</key>
  <true/>
  <!-- Translations live in gen/apple/{en,fr}.lproj/InfoPlist.strings, copied
       into the bundle by bundle.macOS.files in tauri.conf.json. -->
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleLocalizations</key>
  <array>
    <string>en</string>
    <string>fr</string>
  </array>
  <key>NSMicrophoneUsageDescription</key>
  <string>Pressay uses the microphone only while you dictate, to turn your voice into text. Audio is transcribed on this Mac unless you choose a Cloud option.</string>
</dict>
</plist>
