# Pooled Neon connection string. Keep it server-side only.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/pressay?sslmode=require

# Clerk JWT issuer/JWKS used by the native Authorization Code + PKCE client.
PRESSAY_JWT_ISSUER=https://your-instance.clerk.accounts.dev
# Comma-separated: web JWT template audience, then Clerk macOS OAuth client ID.
PRESSAY_JWT_AUDIENCE=pressay-api,pressay-macos-oauth-client-id
PRESSAY_JWT_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json
CLERK_SECRET_KEY=sk_test_...
CRON_SECRET=GENERATE_AT_LEAST_32_RANDOM_CHARACTERS

PORT=8787
NODE_ENV=development

# Stripe remains optional for local BYOK development. Configure every value
# below together to enable BYOK Checkout, Customer Portal and signed webhooks.
# Prefer a restricted server key (rk_test_/rk_live_) scoped to Customers,
# Checkout Sessions, Customer Portal, Charges and Refunds, Coupons,
# Promotion Codes and Subscriptions (write), plus Payment Intents and
# Invoices (read). Grant no other Stripe permissions.
STRIPE_SECRET_KEY=rk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO_BYOK_MONTHLY=price_...
STRIPE_PRICE_PRO_BYOK_ANNUAL=price_...
STRIPE_PRICE_LIFETIME_BYOK=price_...
PRESSAY_CHECKOUT_SUCCESS_URL=https://press-say.app/checkout/success
PRESSAY_CHECKOUT_CANCEL_URL=https://press-say.app/checkout/cancel
PRESSAY_BILLING_RETURN_URL=https://press-say.app/account/billing

# Base64-encoded PKCS#8 Ed25519 private key. Only the corresponding public key
# is embedded in clients. Required before enabling remote entitlements.
PRESSAY_ENTITLEMENT_SIGNING_PRIVATE_KEY=BASE64_PKCS8_PRIVATE_KEY
PRESSAY_FOUNDING_CLAIM_DEADLINE=2026-12-31T23:59:59Z
PRESSAY_OWNER_EMAIL=yoann.andrieux@gmail.com
PRESSAY_ADMIN_MFA_MAX_AGE_MINUTES=10
PRESSAY_REFERRAL_COOKIE_SECRET=GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
ADMIN_ENABLED=false
ADMIN_MUTATIONS_ENABLED=false
COMMERCIAL_CHECKOUT_ENABLED=false
FOUNDING_CLAIMS_ENABLED=false
ACCESS_CAMPAIGNS_ENABLED=false
REFERRALS_ENABLED=false
REMOTE_METRICS_ENABLED=false
PRESSAY_ALLOWED_ORIGINS=https://press-say.app,https://staging.press-say.app
